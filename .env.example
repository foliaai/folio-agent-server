# ==================== 数据库认证信息 ====================

# MySQL 认证
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password

# Redis 认证
REDIS_PASSWORD=your_redis_password
# Redis 用户名（Redis 6.0+支持）
REDIS_USERNAME=

# ==================== 第三方服务 ====================

# Tavily Web 搜索（M2 web_search 工具）
TAVILY_API_KEY=

# 知识引擎 AKS（M2 kb_retrieval 工具，HTTP 只读）
AKS_BASE_URL=http://localhost:8000

# 技能服务（M4 技能层只读消费）
SKILL_SERVICE_URL=http://localhost:8001

# ==================== 模型网关（与 AKS 同名同语义，双模式） ====================

# 网关类型：litellm（默认）| model_lake / openai / openai_compatible
MODEL_GATEWAY_TYPE=litellm

# ModelNexus 网关（model_lake 模式；BASE 必须配到 /v1 结尾）
MODEL_LAKE_BASE=
MODEL_LAKE_API_KEY=

# LiteLLM Proxy 网关（litellm 模式）
LITELLM_PROXY_URL=http://localhost:4000
LITELLM_PROXY_KEY=

# 客户端超时（秒，可选）
# MODEL_GATEWAY_TIMEOUT=300

# ==================== 沙箱 ====================

# 沙箱功能开关（false 时 code_execute 工具直接返回不可用）
SANDBOX_ENABLED=true
# Pyodide 引擎的 Node 可执行路径（部署机固定版本时覆盖，默认取 PATH 上的 node）
SANDBOX_NODE_BIN=node
# 沙箱审计 JSON 行文件目录
SANDBOX_AUDIT_DIR=logs/sandbox

# ==================== 系统配置 ====================

# 应用环境: development, production, testing
APP_ENV=development

# 调试模式
DEBUG=true

# 应用密钥（用于加密等）
APP_SECRET_KEY=your_secret_key_change_in_production

# ==================== 会话附件工作空间（2026-10-08 附件功能） ====================
# MinIO 对象存储（D17：同实例新桶 agent-workspace）
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
# MinerU 文档解析（D3：共用 AKS 侧实例）
MINERU_API_URL=http://192.168.201.25:28000

# ==================== 本地联调鉴权旁路（生产严禁开启） ====================
# DEV_AUTH_BYPASS=1 时（且 APP_ENV != production 才会生效）：
#   身份感知旁路——无凭证按 dev-user 放行；带有效 JWT 用真实身份；
#   带了凭证但验不过一律 401（不静默降级，防污染 dev-user 命名空间）。
# 双重保险：APP_ENV=production 时代码层面直接拒绝激活（auth.py / ws chat.py
# 都有 hard refuse + error log），即使误配也不会在生产生效。
# 仅用于本地无 auth-server 时联调；生产环境配置文件中必须删除此行。
# DEV_AUTH_BYPASS=1
